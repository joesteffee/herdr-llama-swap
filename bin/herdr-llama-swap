#!/usr/bin/env bash
# Open the llama-swap dashboard. No args = session-modal popup (placement/size come from the
# [[panes]] entry in herdr-plugin.toml; the v0.9.5 CLI rejects --placement popup).
# With args they go to `herdr-llama-swap open` (e.g. --target workspace|split|popup).
set -eu
root="${HERDR_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
cd "$root"
export HERDR_PLUGIN_ROOT="$root"
if [ "$#" -eq 0 ]; then set -- --target popup; fi
exec node "$root/src/cli.js" open "$@"
